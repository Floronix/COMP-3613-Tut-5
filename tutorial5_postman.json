{
  "info": {
    "name": "Tutorial 5 - Sell Listing",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "item": [
    {
      "name": "1. Authenticate (Owner)",
      "event": [
        {
          "listen": "test",
          "script": {
            "exec": [
              "pm.test('Auth successful', function () { pm.response.to.have.status(200); });",
              "const token = pm.response.json().access_token;",
              "pm.collectionVariables.set('owner_token', token);"
            ]
          }
        }
      ],
      "request": {
        "method": "POST",
        "header": [{"key": "Content-Type", "value": "application/json"}],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"username\": \"bob\",\n  \"password\": \"bobpass\"\n}"
        },
        "url": "http://127.0.0.1:5000/auth"
      }
    },
    {
      "name": "2. Sell Listing (Success)",
      "event": [
        {
          "listen": "test",
          "script": {
            "exec": [
              "pm.test('Status is 200', function () { pm.response.to.have.status(200); });",
              "pm.test('Message is correct', function () { pm.expect(pm.response.json().message).to.eql('listing removed from customer'); });"
            ]
          }
        }
      ],
      "request": {
        "method": "POST",
        "header": [
          {"key": "Authorization", "value": "Bearer {{owner_token}}"}
        ],
        "url": "http://127.0.0.1:5000/listings/1/sell"
      }
    },
    {
      "name": "3. Sell Listing (Unauthorized)",
      "event": [
        {
          "listen": "test",
          "script": {
            "exec": [
              "pm.test('Status is 401', function () { pm.response.to.have.status(401); });"
            ]
          }
        }
      ],
      "request": {
        "method": "POST",
        "header": [],
        "url": "http://127.0.0.1:5000/listings/1/sell"
      }
    }
  ],
  "variable": [
    {"key": "owner_token", "value": ""}
  ]
}